---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="BangladeshAI — National AI Readiness Research Initiative"
  description="Mapping Bangladesh's AI readiness gaps across 15 domains. 67 critical gaps identified. Public research, not opinions."
  ogTitle="BangladeshAI — Mapping National AI Readiness"
>
  <div class="container" style="padding: 4rem 1.5rem; max-width: 40rem;">
    <div class="eyebrow">BANGLADESHAI</div>
    <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--brand-ink); margin-top: 1rem;">The Research Mission</h1>
    <p style="color: var(--brand-stone-600); font-size: 1rem; margin-top: 1rem; line-height: 1.7;">Mapping national AI readiness gaps with rigorous evidence — not opinions. 67 gaps identified across 15 domains.</p>
    <div style="margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem;">
      <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 0.75rem; padding: 1.25rem;">
        <h3 style="font-weight: 700; font-size: 1rem; color: var(--brand-ink);">Key Findings</h3>
        <ul style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> 67 critical gaps across 15 domains</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> 92 government requirements mapped</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> Oxford AI Readiness Index score: 47.12</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> Country rank: 80/188</li>
        </ul>
      </div>
    </div>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="https://bangladeshai.org" class="btn-primary">Read the Full Report</a>
    </div>
  </div>
</BaseLayout>