---
export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
}

const { title, description, ogTitle, ogImage, schema } = Astro.props;
const year = new Date().getFullYear();
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageURL = ogImage ? new URL(ogImage, siteOrigin).toString() : undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:site_name" content="Emon Hossain" />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}

  <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <style is:global>
    :root {
      --brand-ink: #0B0D10;
      --brand-carbon: #15181D;
      --brand-graphite: #23272E;
      --brand-paper: #F5F5F3;
      --brand-white: #FFFFFF;
      --brand-steel: #A7ADB4;
      --brand-red: #D61F26;
      --brand-stone-50: #FAFAF9;
      --brand-stone-100: #F5F5F3;
      --brand-stone-200: #E5E5E2;
      --brand-stone-300: #D1D3D5;
      --brand-stone-400: #A7ADB4;
      --brand-stone-500: #6F757C;
      --brand-stone-600: #4D535A;
      --brand-stone-700: #343941;
      --brand-stone-800: #23272E;
      --brand-stone-900: #15181D;
      /* Legacy aliases retained only so older route markup renders in the current palette. */
      --brand-indigo: var(--brand-red);
      --brand-sky: var(--brand-steel);
      --brand-emerald: var(--brand-red);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', 'Noto Sans Bengali', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--brand-paper);
      color: var(--brand-stone-900);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }
    img { max-width: 100%; height: auto; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .section { padding: 4rem 0; }
    @media (min-width: 768px) { .section { padding: 5rem 0; } }

    .gradient-text { color: var(--brand-red); -webkit-text-fill-color: currentColor; }
    .brand-gradient { background: var(--brand-ink); border: 1px solid var(--brand-red); }
    .eyebrow {
      font-size: 0.625rem; font-weight: 700; letter-spacing: 0.26em;
      text-transform: uppercase; color: var(--brand-red);
    }

    .btn-primary, .btn-outline {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 2.75rem; padding: 0.75rem 1.2rem; border-radius: 0.65rem;
      font-size: 0.875rem; font-weight: 650; text-decoration: none; transition: 0.2s ease;
    }
    .btn-primary { background: var(--brand-ink); color: white; border: 1px solid var(--brand-ink); }
    .btn-primary:hover { background: var(--brand-carbon); border-color: var(--brand-red); }
    .btn-outline { border: 1px solid var(--brand-stone-300); color: var(--brand-ink); background: transparent; }
    .btn-outline:hover { background: white; border-color: var(--brand-red); }

    .section-title { text-align: center; margin-bottom: 3rem; }
    .section-title h2 {
      font-size: 1.5rem; font-weight: 750; color: var(--brand-ink);
      letter-spacing: -0.025em; margin-top: 0.5rem;
    }
    @media (min-width: 768px) { .section-title h2 { font-size: 1.95rem; } }
    .section-title p { color: var(--brand-stone-500); margin-top: 0.75rem; font-size: 0.9rem; max-width: 40rem; margin-left: auto; margin-right: auto; }

    .grid-4, .grid-3, .grid-2 { display: grid; gap: 1rem; }
    @media (min-width: 768px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
      .grid-3, .grid-2 { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .grid-4 { grid-template-columns: repeat(4, 1fr); }
      .grid-3 { grid-template-columns: repeat(3, 1fr); }
    }

    .nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(245,245,243,0.96); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--brand-stone-200);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4rem; gap: 1rem; }
    .nav-logo { display: flex; align-items: center; gap: 0.65rem; }
    .nav-logo-icon {
      width: 2rem; height: 2rem; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 800; color: white;
    }
    .nav-logo-text .line1, .footer .line1 { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
    .nav-logo-text .line2, .footer .line2 { font-size: 0.55rem; color: var(--brand-stone-400); letter-spacing: 0.08em; text-transform: uppercase; }
    .nav-links { display: none; }
    @media (min-width: 768px) {
      .nav-links { display: flex; align-items: center; gap: 1.4rem; }
      .nav-links a { font-size: 0.875rem; color: var(--brand-stone-600); }
      .nav-links a:hover { color: var(--brand-red); }
    }
    .nav-cta { font-size: 0.83rem; font-weight: 700; color: var(--brand-ink); }
    .nav-cta:hover { color: var(--brand-red); }

    .hero { padding: 5rem 0 4rem; }
    @media (min-width: 768px) { .hero { padding: 7rem 0 5rem; } }
    .hero h1 { font-size: 2.5rem; font-weight: 800; color: var(--brand-ink); line-height: 1.08; letter-spacing: -0.04em; margin-top: 1rem; max-width: 52rem; }
    @media (min-width: 768px) { .hero h1 { font-size: 4rem; } }
    .hero p { color: var(--brand-stone-600); font-size: 1.05rem; margin-top: 1.5rem; max-width: 42rem; line-height: 1.75; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }

    .entity-card, .service-card, .proof-card, .contact-card, .card-hover {
      border-radius: 1rem; border: 1px solid var(--brand-stone-200); background: white;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .entity-card, .service-card, .proof-card { padding: 1.5rem; }
    .contact-card { padding: 1.25rem; text-align: center; display: block; }
    .entity-card:hover, .service-card:hover, .proof-card:hover, .contact-card:hover, .card-hover:hover {
      transform: translateY(-2px); border-color: rgba(214,31,38,.3); box-shadow: 0 10px 28px rgba(11,13,16,.06);
    }
    .entity-card .icon { width: 2.5rem; height: 2.5rem; border-radius: 0.55rem; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800; color: white; margin-bottom: 1rem; }
    .entity-card .role, .service-card .phase { font-size: 0.625rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-stone-400); }
    .entity-card h3, .service-card h3, .proof-card h3 { color: var(--brand-ink); margin-top: 0.3rem; font-weight: 750; }
    .entity-card p, .service-card .desc, .proof-card p { color: var(--brand-stone-600); font-size: 0.875rem; margin-top: 0.55rem; line-height: 1.65; }
    .entity-card .arrow, .service-card .cta { color: var(--brand-red); font-size: 0.875rem; font-weight: 700; margin-top: 1rem; display: inline-flex; gap: .25rem; }
    .service-card ul { margin-top: 1rem; display: flex; flex-direction: column; gap: .45rem; }
    .service-card ul li { color: var(--brand-stone-600); font-size: .875rem; }
    .service-card ul li::before { content: '•'; color: var(--brand-red); font-weight: 800; margin-right: .45rem; }
    .service-card .price { font-size: 1.25rem; font-weight: 750; color: var(--brand-ink); margin-top: .5rem; }
    .service-card .price-period { font-size: .85rem; color: var(--brand-stone-500); }
    .contact-grid { display: grid; gap: 1rem; max-width: 48rem; margin: 2.5rem auto 0; }
    @media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(2, 1fr); } }
    .contact-card .label { font-size: 1rem; font-weight: 750; margin-bottom: .25rem; color: var(--brand-ink); }
    .contact-card .value { color: var(--brand-stone-600); font-size: .875rem; }
    .contact-card .hint { color: var(--brand-stone-400); font-size: .75rem; margin-top: .25rem; }

    .data-section { background: var(--brand-ink); color: white; }
    .data-grid { display: grid; gap: 1rem; }
    @media (min-width: 768px) { .data-grid { grid-template-columns: repeat(3,1fr); } }
    .data-item { padding: 1.25rem; border: 1px solid rgba(255,255,255,.12); border-radius: .8rem; }
    .data-item .num { font-size: 1.1rem; font-weight: 700; color: white; }
    .data-item .label { color: var(--brand-steel); font-size: .8rem; margin-top: .3rem; }

    .footer { background: var(--brand-ink); color: white; padding: 3rem 0; }
    .footer-grid { display: grid; gap: 2rem; }
    @media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; } }
    .footer h4 { font-size: .7rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; margin-bottom: .75rem; }
    .footer ul { display: flex; flex-direction: column; gap: .4rem; }
    .footer a { color: var(--brand-steel); font-size: .78rem; }
    .footer a:hover { color: white; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,.1); margin-top: 2.5rem; padding-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
    @media (min-width: 768px) { .footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; } }
    .footer-bottom p, .footer-bottom a { color: #747A81; font-size: .75rem; }
    .footer-bottom-links { display: flex; gap: 1rem; }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo" aria-label="Emon Hossain home">
        <div class="nav-logo-icon brand-gradient" aria-hidden="true">EH</div>
        <div class="nav-logo-text">
          <div class="line1" style="color: var(--brand-ink);">EMON HOSSAIN</div>
          <div class="line2">AI SYSTEMS · AUTOMATION</div>
        </div>
      </a>
      <div class="nav-links">
        <a href="/about">About</a>
        <a href="/writing">Writing</a>
        <a href="/resources">Resources</a>
        <a href="/contact">Contact</a>
      </div>
      <a href="/contact" class="nav-cta">Work with me →</a>
    </div>
  </nav>

  <main><slot /></main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="line1">EMON HOSSAIN</div>
          <div class="line2" style="margin-top:.25rem;">AI Systems Strategist & Automation Builder</div>
          <p style="color:var(--brand-steel);font-size:.8rem;margin-top:1rem;max-width:28rem;">I build AI systems, test what works, and explain how to use AI in the real world.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/writing">Writing</a></li>
            <li><a href="/resources">Resources</a></li>
            <li><a href="/speaking">Speaking</a></li>
          </ul>
        </div>
        <div>
          <h4>Work & Research</h4>
          <ul>
            <li><a href="/sysmoai">SYSmoAI</a></li>
            <li><a href="/bangladeshai">BangladeshAI.Org</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© {year} Emon Hossain. Dhaka, Bangladesh.</p>
        <div class="footer-bottom-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
