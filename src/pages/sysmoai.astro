---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SYSmoAI — No-Code Automation & AI Systems for Bangladeshi Businesses"
  description="Systems engineering for Bangladeshi agencies and e-commerce. WhatsApp automations, bKash-integrated workflows, and Notion OS architecture."
  ogTitle="SYSmoAI — Systems Engineering for Bangladeshi Businesses"
>
  <div class="container" style="padding: 4rem 1.5rem; max-width: 40rem;">
    <div class="eyebrow">SYSmoAI</div>
    <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--brand-ink); margin-top: 1rem;">The Consulting Arm</h1>
    <p style="color: var(--brand-stone-600); font-size: 1rem; margin-top: 1rem; line-height: 1.7;">WhatsApp automations, bKash-integrated workflows, and Notion OS shipped for Bangladeshi SMBs.</p>

    <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
      <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 0.75rem; padding: 1.25rem;">
        <h3 style="font-weight: 700; font-size: 1rem; color: var(--brand-ink);">What We Build</h3>
        <ul style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> Custom Make/Zapier/n8n automation flows</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> Notion CRM, project management, and SOP systems</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> AI integration (LLM, vision, summarization)</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> bKash payment webhooks and WhatsApp notification bots</li>
          <li style="color: var(--brand-stone-600); font-size: 0.875rem; display: flex; gap: 0.5rem;"><span style="color: var(--brand-emerald);">&#x2713;</span> Custom AI agent pipelines for customer support and lead qualification</li>
        </ul>
      </div>
    </div>
    
    <div style="margin-top: 2rem; text-align: center;">
      <a href="/services" class="btn-primary">View Services & Pricing</a>
    </div>
  </div>
</BaseLayout>