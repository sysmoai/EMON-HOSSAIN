---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Writing | Emon Hossain — AI Systems & No-Code Strategy"
  description="Practical writing on AI, no-code automation, and systems thinking for Bangladeshi businesses."
  ogTitle="Writing — Emon Hossain"
>
  <div class="container section" style="max-width: 40rem;">
    <div class="section-title">
      <div class="eyebrow">WRITING</div>
      <h2>Notes from the field.</h2>
      <p>Practical writing on AI, no-code automation, and systems thinking for Bangladeshi businesses.</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <article style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem; transition: all 0.2s ease;">
        <div style="color: var(--brand-stone-400); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em;">Coming Soon</div>
        <h3 style="margin-top: 0.5rem; font-weight: 700; color: var(--brand-ink);">AI From Hype — From Marketing Word to Operational Lever</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem; line-height: 1.6;">The gap between "AI" as a marketing label and "AI" as a tool that actually saves time in a Bangladeshi agency. Practical examples from deployed systems.</p>
      </article>
      <article style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem; transition: all 0.2s ease;">
        <div style="color: var(--brand-stone-400); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em;">Coming Soon</div>
        <h3 style="margin-top: 0.5rem; font-weight: 700; color: var(--brand-ink);">Founder Branding vs. Product Branding</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem; line-height: 1.6;">Why Bangladeshi founders need to separate their personal brand from their product — and what happens when they don't.</p>
      </article>
      <article style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem; transition: all 0.2s ease;">
        <div style="color: var(--brand-stone-400); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em;">Coming Soon</div>
        <h3 style="margin-top: 0.5rem; font-weight: 700; color: var(--brand-ink);">Simple Systems Outperform Complex Ones</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem; line-height: 1.6;">Why the best automation in Bangladesh is a single Make.com scenario connected to WhatsApp — and why most engineers over-engineer.</p>
      </article>
    </div>
  </div>
</BaseLayout>