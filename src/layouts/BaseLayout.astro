---
export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogImage?: string;
}

const { title, description, ogTitle, ogImage } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />
  <style is:global>
    /* Brand System — from Notion Brand OS */
    :root {
      --brand-indigo: #4F46E5;
      --brand-sky: #0EA5E9;
      --brand-emerald: #10B981;
      --brand-ink: #0F172A;
      --brand-paper: #FAFAF9;
      --brand-stone-50: #FAFAF9;
      --brand-stone-100: #F5F5F4;
      --brand-stone-200: #E7E5E4;
      --brand-stone-300: #D6D3D1;
      --brand-stone-400: #A8A29E;
      --brand-stone-500: #78716C;
      --brand-stone-600: #57534E;
      --brand-stone-700: #44403C;
      --brand-stone-800: #292524;
      --brand-stone-900: #1C1917;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--brand-paper);
      color: var(--brand-stone-900);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .gradient-text {
      background: linear-gradient(145deg, var(--brand-indigo), var(--brand-sky), var(--brand-emerald));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .brand-gradient {
      background: linear-gradient(145deg, var(--brand-indigo), var(--brand-sky), var(--brand-emerald));
    }
    .eyebrow {
      font-size: 0.625rem; font-weight: 600; letter-spacing: 0.36em;
      text-transform: uppercase; color: var(--brand-stone-400);
    }
    .card-hover { transition: all 0.2s ease; }
    .card-hover:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(79,70,229,0.1); }
    .btn-primary {
      display: inline-flex; align-items: center; padding: 0.75rem 1.5rem;
      border-radius: 0.75rem; background: var(--brand-ink); color: white;
      font-size: 0.875rem; font-weight: 600; text-decoration: none;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--brand-stone-800); }
    .btn-outline {
      display: inline-flex; align-items: center; padding: 0.75rem 1.5rem;
      border-radius: 0.75rem; border: 1px solid var(--brand-stone-300);
      color: var(--brand-ink); font-size: 0.875rem; font-weight: 600;
      text-decoration: none; transition: background 0.2s;
    }
    .btn-outline:hover { background: var(--brand-stone-100); }
    .section { padding: 4rem 0; }
    @media (min-width: 768px) { .section { padding: 5rem 0; } }
    .section-title { text-align: center; margin-bottom: 3rem; }
    .section-title h2 {
      font-size: 1.5rem; font-weight: 700; color: var(--brand-ink);
      text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.5rem;
    }
    @media (min-width: 768px) { .section-title h2 { font-size: 1.875rem; } }
    .section-title p { color: var(--brand-stone-500); margin-top: 0.75rem; font-size: 0.875rem; max-width: 36rem; margin-left: auto; margin-right: auto; }
    .grid-4 { display: grid; gap: 1rem; }
    @media (min-width: 768px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .grid-4 { grid-template-columns: repeat(4, 1fr); } }
    .grid-3 { display: grid; gap: 1rem; }
    @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
    .grid-2 { display: grid; gap: 1rem; }
    @media (min-width: 768px) { .grid-2 { grid-template-columns: repeat(2, 1fr); } }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }
    img { max-width: 100%; height: auto; }

    /* Navigation */
    .nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(250, 250, 249, 0.95); backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--brand-stone-200);
    }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      height: 4rem;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 0.5rem;
    }
    .nav-logo-icon {
      width: 2rem; height: 2rem; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 700; color: white;
    }
    .nav-logo-text .line1 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-logo-text .line2 { font-size: 0.55rem; color: var(--brand-stone-400); letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-links { display: none; }
    @media (min-width: 768px) {
      .nav-links { display: flex; align-items: center; gap: 1.5rem; }
      .nav-links a { font-size: 0.875rem; color: var(--brand-stone-600); transition: color 0.2s; }
      .nav-links a:hover { color: var(--brand-ink); }
    }
    .nav-wa { font-size: 0.875rem; font-weight: 600; color: var(--brand-indigo); }
    .nav-wa:hover { color: var(--brand-sky); }

    /* Footer */
    .footer {
      background: var(--brand-ink); color: white; padding: 3rem 0;
    }
    .footer-grid { display: grid; gap: 2rem; }
    @media (min-width: 768px) { .footer-grid { grid-template-columns: repeat(4, 1fr); } }
    .footer h4 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.75rem; }
    .footer ul { display: flex; flex-direction: column; gap: 0.375rem; }
    .footer a { color: var(--brand-stone-400); font-size: 0.75rem; transition: color 0.2s; }
    .footer a:hover { color: white; }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.1); margin-top: 2.5rem;
      padding-top: 1.5rem; display: flex; flex-direction: column;
      align-items: center; gap: 1rem;
    }
    @media (min-width: 768px) {
      .footer-bottom { flex-direction: row; justify-content: space-between; }
    }
    .footer-bottom p { color: var(--brand-stone-500); font-size: 0.75rem; }
    .footer-bottom-links { display: flex; gap: 1rem; }
    .footer-bottom-links a { color: var(--brand-stone-500); font-size: 0.75rem; transition: color 0.2s; }
    .footer-bottom-links a:hover { color: white; }

    .hero { padding: 5rem 0 4rem; }
    @media (min-width: 768px) { .hero { padding: 7rem 0 5rem; } }
    .hero h1 { font-size: 2.25rem; font-weight: 700; color: var(--brand-ink); line-height: 1.2; margin-top: 1rem; }
    @media (min-width: 768px) { .hero h1 { font-size: 3.75rem; } }
    .hero p { color: var(--brand-stone-600); font-size: 1.125rem; margin-top: 1.5rem; max-width: 36rem; line-height: 1.7; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
    .hero-stats { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 3rem; }
    .hero-stat { }
    .hero-stat-num { font-size: 1.5rem; font-weight: 700; color: var(--brand-ink); }
    .hero-stat-label { color: var(--brand-stone-500); font-size: 0.875rem; margin-left: 0.25rem; }

    /* Data section (dark) */
    .data-section { background: var(--brand-ink); color: white; }
    .data-grid { display: grid; gap: 1.5rem; text-align: center; }
    @media (min-width: 768px) { .data-grid { grid-template-columns: repeat(5, 1fr); } }
    .data-item .num { font-size: 2.25rem; font-weight: 700; }
    @media (min-width: 768px) { .data-item .num { font-size: 3rem; } }
    .data-item .label { color: var(--brand-stone-400); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }

    /* Service cards */
    .service-card {
      border-radius: 1rem; border: 1px solid var(--brand-stone-200);
      background: white; padding: 1.5rem; transition: all 0.2s ease;
    }
    .service-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(79,70,229,0.1); }
    .service-card.highlight { border-color: rgba(79,70,229,0.3); box-shadow: 0 4px 20px rgba(79,70,229,0.08); }
    .service-card .phase { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.36em; text-transform: uppercase; color: var(--brand-stone-400); }
    .service-card h3 { color: var(--brand-ink); margin-top: 0.5rem; }
    .service-card .price { font-size: 1.5rem; font-weight: 700; color: var(--brand-indigo); margin-top: 0.5rem; }
    .service-card .price-period { color: var(--brand-stone-500); font-size: 0.875rem; }
    .service-card .desc { color: var(--brand-stone-600); font-size: 0.875rem; margin-top: 0.75rem; line-height: 1.6; }
    .service-card ul { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.375rem; }
    .service-card ul li { color: var(--brand-stone-600); font-size: 0.875rem; display: flex; align-items: flex-start; gap: 0.5rem; }
    .service-card ul li::before { content: "✓"; color: var(--brand-emerald); font-weight: 700; }
    .service-card .cta {
      display: inline-flex; align-items: center; gap: 0.25rem;
      margin-top: 1.5rem; font-size: 0.875rem; font-weight: 600;
      color: var(--brand-indigo); transition: gap 0.2s;
    }
    .service-card .cta:hover { gap: 0.5rem; }

    /* Entity card */
    .entity-card {
      border-radius: 1rem; border: 1px solid var(--brand-stone-200);
      background: white; padding: 1.5rem; transition: all 0.2s ease;
      display: block;
    }
    .entity-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(79,70,229,0.1); }
    .entity-card .icon {
      width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.125rem; font-weight: 700; color: white; margin-bottom: 1rem;
    }
    .entity-card .role { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.36em; text-transform: uppercase; color: var(--brand-stone-400); }
    .entity-card h3 { color: var(--brand-ink); margin-top: 0.25rem; transition: color 0.2s; }
    .entity-card:hover h3 { color: var(--brand-indigo); }
    .entity-card p { color: var(--brand-stone-600); font-size: 0.875rem; margin-top: 0.5rem; line-height: 1.6; }
    .entity-card .arrow { color: var(--brand-indigo); font-size: 0.875rem; font-weight: 600; margin-top: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem; transition: gap 0.2s; }
    .entity-card:hover .arrow { gap: 0.5rem; }

    /* Contact cards */
    .contact-grid { display: grid; gap: 1rem; max-width: 48rem; margin: 2.5rem auto 0; }
    @media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(3, 1fr); } }
    .contact-card {
      border-radius: 0.75rem; border: 1px solid var(--brand-stone-200);
      background: white; padding: 1.25rem; text-align: center;
      transition: all 0.2s ease; display: block;
    }
    .contact-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(79,70,229,0.1); }
    .contact-card .label { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
    .contact-card .value { color: var(--brand-stone-500); font-size: 0.875rem; }
    .contact-card .hint { color: var(--brand-stone-400); font-size: 0.75rem; margin-top: 0.25rem; }

    /* Proof card */
    .proof-card {
      border-radius: 1rem; border: 1px solid var(--brand-stone-200);
      background: white; padding: 1.5rem; transition: all 0.2s ease;
    }
    .proof-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(79,70,229,0.1); }
    .proof-card .stars { color: #F59E0B; font-size: 0.875rem; margin-bottom: 0.5rem; }
    .proof-card h3 { font-weight: 700; color: var(--brand-ink); }
    .proof-card p { color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem; }
    .proof-card .meta { display: flex; gap: 1rem; margin-top: 1rem; }
    .proof-card .meta span { font-size: 0.875rem; }
    .proof-card .meta .highlight { color: var(--brand-emerald); font-weight: 600; }

    /* Cookie consent */
    .cookie-bar {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
      background: var(--brand-ink); color: white; padding: 0.75rem 1rem;
      display: flex; align-items: center; justify-content: center;
      flex-wrap: wrap; gap: 0.75rem; font-size: 0.75rem;
    }
    .cookie-bar a { color: var(--brand-sky); text-decoration: underline; }
    .cookie-bar button {
      padding: 0.375rem 0.75rem; border-radius: 0.375rem;
      font-size: 0.75rem; font-weight: 600; border: none; cursor: pointer;
    }
    .cookie-bar .accept { background: var(--brand-indigo); color: white; }
    .cookie-bar .decline { background: transparent; color: var(--brand-stone-400); border: 1px solid var(--brand-stone-600); }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <div class="nav-logo-icon brand-gradient">E</div>
        <div class="nav-logo-text">
          <div class="line1" style="color: var(--brand-ink);">EMON HOSSAIN</div>
          <div class="line2">EMONHOSSAIN.PRO</div>
        </div>
      </a>
      <div class="nav-links">
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/writing">Writing</a>
        <a href="/contact">Contact</a>
      </div>
      <a href="https://wa.me/8801865385348" class="nav-wa">WhatsApp &rarr;</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="nav-logo" style="margin-bottom: 1rem;">
            <div class="nav-logo-icon brand-gradient">E</div>
            <div>
              <div class="line1" style="color: white;">EMON HOSSAIN</div>
              <div class="line2" style="color: var(--brand-stone-400);">EMONHOSSAIN.PRO</div>
            </div>
          </div>
          <p style="color: var(--brand-stone-400); font-size: 0.75rem;">AI Systems Strategist &middot; No-Code Builder &middot; Founder, BangladeshAI</p>
          <p style="color: var(--brand-stone-500); font-size: 0.75rem; margin-top: 0.5rem;">Built for Bangladesh. Designed for precision.</p>
        </div>
        <div>
          <h4>Emon</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/writing">Writing</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4>SYSmoAI</h4>
          <ul>
            <li><a href="https://sysmoai.com">Company</a></li>
            <li><a href="/services">Services &amp; Pricing</a></li>
            <li><a href="https://wa.me/8801865385348">Book a Call</a></li>
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href="mailto:contact@emonhossain.pro">contact@emonhossain.pro</a></li>
            <li><a href="https://wa.me/8801865385348">WhatsApp: +880 1865-385348</a></li>
            <li style="color: var(--brand-stone-500); font-size: 0.75rem;">Dhaka, Bangladesh</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {year} Emon Hossain. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <div class="cookie-bar" id="cookie-bar">
    <span>We use cookies to analyze site traffic and improve performance. No personal data is sold. <a href="/privacy">Privacy Policy</a></span>
    <button class="decline" onclick="document.getElementById('cookie-bar').style.display='none'">Decline non-essential</button>
    <button class="accept" onclick="document.getElementById('cookie-bar').style.display='none'">Accept all</button>
  </div>
</body>
</html>