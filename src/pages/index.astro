---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Emon Hossain | AI Systems Architect & No-Code Automation Strategist | Dhaka"
  description="AI automation and no-code systems for Bangladeshi businesses. Founder of SYSmoAI and AI Premium Shop. Book a 3-day AI Profit Audit — 4,999 BDT."
  ogTitle="Emon Hossain — AI Systems Architect, Built for Bangladesh"
>
  <!-- HERO -->
  <section class="container hero">
    <div class="eyebrow">EMONHOSSAIN.PRO</div>
    <h1>AI systems strategist.<br /><span class="gradient-text">Built for Bangladesh.</span></h1>
    <p>I build deterministic systems and probabilistic AI for Bangladeshi businesses. No theatre, no hype — just leverage you can measure.</p>
    <div class="hero-cta">
      <a href="https://wa.me/8801865385348" class="btn-primary">Book AI Profit Audit &mdash; 4,999 BDT</a>
      <a href="https://bangladeshai.org" class="btn-outline">Get the Bangladesh AI Readiness Report</a>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><span class="hero-stat-num">5&#9733;</span><span class="hero-stat-label">client rating</span></div>
      <div class="hero-stat"><span class="hero-stat-num">10+</span><span class="hero-stat-label">hrs/week saved per client</span></div>
      <div class="hero-stat"><span class="hero-stat-num">67</span><span class="hero-stat-label">gaps mapped nationally</span></div>
    </div>
  </section>

  <!-- ENTITIES -->
  <section class="section container">
    <div class="section-title">
      <div class="eyebrow">THE FOUR SYSTEMS</div>
      <h2>One operator. Four systems of work.</h2>
    </div>
    <div class="grid-4">
      <a href="/about" class="entity-card">
        <div class="icon brand-gradient">E</div>
        <div class="role">THE PRACTITIONER</div>
        <h3>Emon</h3>
        <p>Strategist and builder. Replacing manual labor with deterministic systems and probabilistic models.</p>
        <div class="arrow">Learn more &rarr;</div>
      </a>
      <a href="https://sysmoai.com" class="entity-card">
        <div class="icon" style="background: linear-gradient(135deg, #3B82F6, #1D4ED8);">S</div>
        <div class="role">THE CONSULTING ARM</div>
        <h3>SYSmoAI</h3>
        <p>WhatsApp automations, bKash-integrated workflows, and Notion OS shipped for Bangladeshi SMBs.</p>
        <div class="arrow">Learn more &rarr;</div>
      </a>
      <a href="https://aipremiumshop.com" class="entity-card">
        <div class="icon" style="background: linear-gradient(135deg, #F59E0B, #EA580C);">A</div>
        <div class="role">THE COMMERCE ARM</div>
        <h3>AI Premium Shop</h3>
        <p>Bangladesh's AI subscription marketplace. 100+ premium tools delivered via WhatsApp with bKash/Nagad.</p>
        <div class="arrow">Learn more &rarr;</div>
      </a>
      <a href="https://bangladeshai.org" class="entity-card">
        <div class="icon" style="background: linear-gradient(135deg, #10B981, #047857);">B</div>
        <div class="role">THE RESEARCH MISSION</div>
        <h3>BangladeshAI</h3>
        <p>Mapping national AI readiness gaps with rigorous evidence — not opinions. 67 gaps identified.</p>
        <div class="arrow">Learn more &rarr;</div>
      </a>
    </div>
  </section>

  <!-- DATA SECTION -->
  <section class="section data-section">
    <div class="container">
      <div class="section-title">
        <div class="eyebrow" style="color: var(--brand-stone-400);">THE DATA</div>
        <h2 style="color: white;">The State of AI in Bangladesh</h2>
        <p style="color: var(--brand-stone-400);">Hard numbers from the BangladeshAI 2024 Readiness Report. No speculation, no theatre — just data.</p>
      </div>
      <div class="data-grid">
        <div class="data-item"><div class="num" style="color: var(--brand-emerald);">67</div><div class="label">Critical Gaps</div></div>
        <div class="data-item"><div class="num" style="color: var(--brand-sky);">15</div><div class="label">Domains Analyzed</div></div>
        <div class="data-item"><div class="num" style="color: var(--brand-indigo);">92</div><div class="label">Gov Requirements</div></div>
        <div class="data-item"><div class="num" style="color: white;">47.12</div><div class="label">Oxford Index Score</div></div>
        <div class="data-item"><div class="num" style="color: white;">80/188</div><div class="label">Country Rank</div></div>
      </div>
      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="https://bangladeshai.org" class="btn-outline" style="border-color: rgba(255,255,255,0.2); color: white;">Read the full report &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section container" id="services">
    <div class="section-title">
      <div class="eyebrow">ENGAGEMENTS</div>
      <h2>SYSmoAI Services</h2>
      <p>Systems engineering for Bangladeshi agencies and e-commerce. Saving hours, increasing leverage.</p>
    </div>
    <div class="grid-3">
      <div class="service-card">
        <div class="phase">Phase 1</div>
        <h3>AI Profit Audit</h3>
        <div class="price">4,999 BDT</div>
        <div class="desc">3 days. 5-10 automation opportunities identified with ROI projection.</div>
        <ul>
          <li>Workflow analysis</li>
          <li>Tool stack recommendation</li>
          <li>ROI projection per opportunity</li>
          <li>30-minute findings call</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Learn More &rarr;</a>
      </div>
      <div class="service-card highlight">
        <div class="phase">Phase 2 — Most Common</div>
        <h3>Workflow Build Sprint</h3>
        <div class="price">24,999+ BDT</div>
        <div class="desc">7-14 days. Full build, testing, and team handoff.</div>
        <ul>
          <li>Custom Make/Zapier flows</li>
          <li>Notion OS architecture</li>
          <li>AI model integration</li>
          <li>bKash/WhatsApp connectivity</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Book Sprint &rarr;</a>
      </div>
      <div class="service-card">
        <div class="phase">Phase 3</div>
        <h3>Advisory Retainer</h3>
        <div class="price">14,999 <span class="price-period">/mo</span></div>
        <div class="desc">Ongoing optimization and maintenance of deployed systems.</div>
        <ul>
          <li>Error handling</li>
          <li>Bi-weekly strategy calls</li>
          <li>Performance optimization</li>
          <li>Priority support</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Learn More &rarr;</a>
      </div>
      <div class="service-card">
        <div class="phase">On-Demand</div>
        <h3>Premium 1:1 Consultation</h3>
        <div class="price">4,999 <span class="price-period">/hr</span></div>
        <div class="desc">Direct access for technical or strategic roadblocks. Min 2 hours.</div>
        <ul>
          <li>Architecture review</li>
          <li>Tool selection</li>
          <li>Recorded session</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Book Consultation &rarr;</a>
      </div>
      <div class="service-card">
        <div class="phase">Team</div>
        <h3>Enterprise Workshop</h3>
        <div class="price">49,999+ BDT</div>
        <div class="desc">Half- or full-day training for your team on AI and No-Code tools.</div>
        <ul>
          <li>Custom curriculum</li>
          <li>Live build-along exercises</li>
          <li>Post-workshop resources</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Inquire &rarr;</a>
      </div>
      <div class="service-card">
        <div class="phase">DIY</div>
        <h3>Templates &amp; SOP Packs</h3>
        <div class="price">Free / Paid</div>
        <div class="desc">Productized Notion systems and automation templates for founders who build themselves.</div>
        <ul>
          <li>Notion CEO OS — Free kit</li>
          <li>Automation SOPs — Coming soon</li>
          <li>Workflow templates — Coming soon</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Get Free Kit &rarr;</a>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="section" style="background: var(--brand-stone-100);">
    <div class="container">
      <div class="section-title">
        <div class="eyebrow">EVIDENCE</div>
        <h2>Real systems. Real results.</h2>
      </div>
      <div class="grid-3">
        <div class="proof-card">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h3>Hayder Voice</h3>
          <p>First B2B Client. Complete overhaul of project intake, tracking, and delivery for a leading voiceover agency.</p>
          <div class="meta">
            <span class="highlight">15 hrs/week saved</span>
            <span style="color: var(--brand-stone-400);">|</span>
            <span style="color: var(--brand-stone-500);">5&#9733; rating</span>
          </div>
        </div>
        <div class="proof-card">
          <h3>National AI Readiness Report</h3>
          <p>Comprehensive audit of Bangladesh's AI capability across 15 domains. 67 critical gaps identified.</p>
          <div class="meta">
            <span style="color: var(--brand-indigo); font-weight: 600; font-size: 0.875rem;">67 gaps mapped &rarr;</span>
          </div>
        </div>
        <div class="proof-card">
          <h3>Notion CEO OS</h3>
          <p>Productized Notion system with CRM, Projects, SOPs, and Goals — all linked, all queryable. Deployed in under 30 min.</p>
          <div class="meta">
            <span style="color: var(--brand-indigo); font-weight: 600; font-size: 0.875rem;">5 modules &middot; Free kit</span>
          </div>
        </div>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="https://wa.me/8801865385348" class="btn-primary">Book AI Profit Audit &mdash; 4,999 BDT</a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section container" id="contact">
    <div class="section-title" style="margin-bottom: 0;">
      <div class="eyebrow">CONTACT</div>
      <h2>Let's talk.</h2>
      <p>Email, WhatsApp, or the form below. I reply within a few hours during business days.</p>
    </div>
    <div class="contact-grid">
      <a href="mailto:contact@emonhossain.pro" class="contact-card">
        <div class="label" style="color: var(--brand-indigo);">Email</div>
        <div class="value">contact@emonhossain.pro</div>
        <div class="hint">Replies within 24h</div>
      </a>
      <a href="https://wa.me/8801865385348" class="contact-card">
        <div class="label" style="color: var(--brand-emerald);">WhatsApp</div>
        <div class="value">+880 1865-385348</div>
        <div class="hint">Fastest option</div>
      </a>
      <a href="https://wa.me/8801865385348?text=Hi%20Emon%2C%20I%27m%20interested%20in%20the%20AI%20Profit%20Audit" class="contact-card">
        <div class="label" style="color: var(--brand-ink);">Book Audit</div>
        <div class="value">AI Profit Audit</div>
        <div class="hint">4,999 BDT &middot; 3 days</div>
      </a>
    </div>
    <div style="text-align: center; margin-top: 2rem; color: var(--brand-stone-400); font-size: 0.75rem;">
      Dhaka, Bangladesh &middot; Sun-Thu 10 AM - 7 PM BST
    </div>
  </section>
</BaseLayout>