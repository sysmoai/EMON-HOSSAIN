---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Emon Hossain"
  description="This page doesn't exist or has been moved."
>
  <div style="display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 4rem 1.5rem; text-align: center;">
    <div style="max-width: 24rem;">
      <div style="font-size: 6rem; font-weight: 700; color: var(--brand-stone-300);">404</div>
      <h1 style="font-size: 1.25rem; font-weight: 700; color: var(--brand-ink); margin-top: 1rem;">Off the map.</h1>
      <p style="color: var(--brand-stone-500); margin-top: 0.5rem; font-size: 0.875rem;">
        The page you're looking for doesn't exist, has been moved, or was never published.
      </p>
      <a href="/" class="btn-primary" style="margin-top: 1.5rem;">Go home</a>
    </div>
  </div>
</BaseLayout>