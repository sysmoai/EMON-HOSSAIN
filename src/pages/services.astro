---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services & Pricing | SYSmoAI — Automation & AI Systems for Bangladeshi Businesses"
  description="AI Profit Audit (4,999 BDT), Workflow Build Sprint (24,999+ BDT), Advisory Retainer (14,999/mo), and more. No-code and AI systems for Dhaka agencies and e-commerce."
  ogTitle="SYSmoAI Services & Pricing — Automation for Bangladeshi Businesses"
>
  <div class="container section">
    <div class="section-title">
      <div class="eyebrow">SERVICES & PRICING</div>
      <h2>SYSmoAI Engagements</h2>
      <p>Fixed-price, outcome-based systems engineering. Pay for leverage, not hours.</p>
    </div>

    <div style="display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));">
      <div class="service-card highlight">
        <div class="phase">Start Here</div>
        <h3>AI Profit Audit</h3>
        <div class="price">4,999 BDT</div>
        <div class="desc">3-day assessment of your current operations. Identifies 5-10 automation opportunities with clear ROI projections.</div>
        <ul>
          <li>Full workflow audit</li>
          <li>Tool stack evaluation</li>
          <li>ROI projection per opportunity</li>
          <li>30-minute findings presentation</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Book Now &rarr;</a>
      </div>

      <div class="service-card">
        <div class="phase">Most Common</div>
        <h3>Workflow Build Sprint</h3>
        <div class="price">24,999+ BDT</div>
        <div class="desc">7-14 day build. From scoping to deployment to team training. End-to-end automation delivery.</div>
        <ul>
          <li>Custom Make/Zapier/n8n flows</li>
          <li>Notion OS architecture</li>
          <li>AI model integration (LLM/vision)</li>
          <li>bKash / WhatsApp / email connectivity</li>
          <li>Documentation and handoff</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Book Sprint &rarr;</a>
      </div>

      <div class="service-card">
        <div class="phase">Ongoing</div>
        <h3>Advisory Retainer</h3>
        <div class="price">14,999 <span class="price-period">/mo</span></div>
        <div class="desc">Continuous optimization of your deployed automation stack. Error monitoring, updates, and growth.</div>
        <ul>
          <li>Error handling and monitoring</li>
          <li>Bi-weekly strategy calls</li>
          <li>Performance optimization</li>
          <li>Priority support</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Learn More &rarr;</a>
      </div>

      <div class="service-card">
        <div class="phase">On-Demand</div>
        <h3>Premium 1:1 Consultation</h3>
        <div class="price">4,999 <span class="price-period">/hr</span></div>
        <div class="desc">Direct access to Emon for technical or strategic roadblocks. Minimum 2 hours.</div>
        <ul>
          <li>Architecture review</li>
          <li>Tool selection guidance</li>
          <li>Recorded session included</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Book Consultation &rarr;</a>
      </div>

      <div class="service-card">
        <div class="phase">Team</div>
        <h3>Enterprise Workshop</h3>
        <div class="price">49,999+ BDT</div>
        <div class="desc">Half- or full-day training for your team on AI and No-Code tools. Hands-on, practical, immediately applicable.</div>
        <ul>
          <li>Custom curriculum for your use case</li>
          <li>Live build-along exercises</li>
          <li>Post-workshop reference materials</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Inquire &rarr;</a>
      </div>

      <div class="service-card">
        <div class="phase">DIY</div>
        <h3>Templates &amp; SOP Packs</h3>
        <div class="price">Free / Paid</div>
        <div class="desc">Productized Notion systems and automation templates for founders who build themselves.</div>
        <ul>
          <li>Notion CEO OS — Free starter kit</li>
          <li>Automation SOPs — Coming soon</li>
          <li>Workflow templates — Coming soon</li>
        </ul>
        <a href="https://wa.me/8801865385348" class="cta">Get Free Kit &rarr;</a>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3rem; padding: 2rem; background: var(--brand-stone-100); border-radius: 1rem;">
      <p style="font-size: 0.875rem; color: var(--brand-stone-600);">Not sure which engagement fits? Start with a free 15-minute discovery call.</p>
      <a href="https://wa.me/8801865385348" class="btn-primary" style="margin-top: 1rem;">Book a Discovery Call</a>
    </div>
  </div>
</BaseLayout>