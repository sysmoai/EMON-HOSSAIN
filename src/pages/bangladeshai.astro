---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="BangladeshAI.Org | Research & Public-Interest AI Work"
  description="BangladeshAI.Org is a Bangladesh-focused AI research and public-interest surface connected to Emon Hossain's work on AI adoption and governance."
  ogTitle="BangladeshAI.Org — Research & Public-Interest AI Work"
>
  <div class="container" style="padding:4rem 1.5rem;max-width:46rem;">
    <div class="eyebrow">BANGLADESHAI.ORG</div>
    <h1 style="font-size:2rem;font-weight:800;color:var(--brand-ink);margin-top:1rem;">Bangladesh-focused AI research and public-interest work.</h1>
    <p style="color:var(--brand-stone-600);font-size:1rem;margin-top:1rem;line-height:1.75;">BangladeshAI.Org is used for research, education and public-interest work around AI adoption, governance and Bangladesh-specific constraints. Research claims should be read with their sources and methodology rather than as personal-brand marketing statistics.</p>

    <div class="grid-2" style="margin-top:2rem;">
      <div class="entity-card">
        <div class="role">RESEARCH</div>
        <h3>AI adoption & governance</h3>
        <p>Evidence-led work on readiness, institutions, implementation capacity and the practical conditions that shape AI adoption.</p>
      </div>
      <div class="entity-card">
        <div class="role">PUBLIC INTEREST</div>
        <h3>Bangladesh context</h3>
        <p>Translate global AI developments and datasets into questions relevant to local institutions, businesses, educators and citizens.</p>
      </div>
    </div>

    <div style="margin-top:2rem;padding:1.5rem;background:white;border:1px solid var(--brand-stone-200);border-radius:1rem;">
      <div class="eyebrow">AFFILIATION RULE</div>
      <p style="color:var(--brand-stone-600);font-size:.875rem;line-height:1.75;margin-top:.75rem;">For formal academic submissions, Emon Hossain's affiliation is <strong>Independent Researcher, Dhaka, Bangladesh</strong>. BangladeshAI.Org is not used as his formal academic institutional affiliation.</p>
    </div>

    <div class="hero-cta" style="margin-top:2rem;">
      <a href="https://bangladeshai.org" class="btn-primary">Visit BangladeshAI.Org</a>
      <a href="/about" class="btn-outline">About Emon</a>
    </div>
  </div>
</BaseLayout>
