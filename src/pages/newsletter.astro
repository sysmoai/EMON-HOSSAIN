---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter | Emon Hossain — Practical AI Systems Notes"
  description="Occasional notes from Emon Hossain on practical AI systems, automation, business operations and AI adoption."
  ogTitle="Newsletter — Emon Hossain"
>
  <div class="container section" style="max-width:42rem;">
    <div class="section-title">
      <div class="eyebrow">NEWSLETTER</div>
      <h2>Practical AI systems notes.</h2>
      <p>The newsletter is not presented as an active publication until a real subscription and delivery workflow is ready. For now, use the contact email if you want to be notified when it launches.</p>
    </div>
    <div style="background:white;border:1px solid var(--brand-stone-200);border-radius:1rem;padding:1.75rem;text-align:center;">
      <div class="eyebrow">PRE-LAUNCH</div>
      <p style="color:var(--brand-stone-600);font-size:.875rem;line-height:1.7;margin-top:.75rem;">Future issues will focus on one real system or test, one useful AI observation, and one practical takeaway rather than a generic AI-news digest.</p>
      <a href="mailto:contact@emonhossain.pro?subject=Newsletter%20launch%20notification" class="btn-primary" style="margin-top:1.25rem;">Request Launch Notification</a>
    </div>
  </div>
</BaseLayout>
