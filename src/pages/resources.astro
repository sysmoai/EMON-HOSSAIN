---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resources | Emon Hossain — Free Tools, Templates & Guides"
  description="Free Notion CEO OS kit, automation guides, templates and SOPs for Bangladeshi founders and operators."
  ogTitle="Resources — Emon Hossain"
>
  <div class="container section" style="max-width: 40rem;">
    <div class="section-title">
      <div class="eyebrow">RESOURCES</div>
      <h2>Free tools, for builders.</h2>
      <p>Productized systems and templates for founders who build themselves.</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem;" class="card-hover">
        <h3 style="font-weight: 700; color: var(--brand-ink);">Notion CEO OS — Free Kit</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem;">Complete Notion workspace with CRM, Projects, SOPs, Goals, and Journal — all linked, all queryable. Deployed in under 30 min.</p>
        <a href="https://wa.me/8801865385348?text=I%20want%20the%20free%20Notion%20CEO%20OS%20kit" class="cta" style="display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 1rem; font-size: 0.875rem; font-weight: 600; color: var(--brand-indigo);">Get Free Kit &rarr;</a>
      </div>
      <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem;" class="card-hover">
        <div style="color: var(--brand-stone-400); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em;">Coming Soon</div>
        <h3 style="font-weight: 700; color: var(--brand-ink); margin-top: 0.25rem;">Automation SOPs</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem;">Standard operating procedures for common automation patterns: lead capture, invoice generation, order processing, and more.</p>
      </div>
      <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem;" class="card-hover">
        <div style="color: var(--brand-stone-400); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em;">Coming Soon</div>
        <h3 style="font-weight: 700; color: var(--brand-ink); margin-top: 0.25rem;">Workflow Templates</h3>
        <p style="color: var(--brand-stone-500); font-size: 0.875rem; margin-top: 0.5rem;">Ready-to-import Make.com and n8n workflow templates for common business processes.</p>
      </div>
    </div>
  </div>
</BaseLayout>