---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Emon Hossain | Business, Creator, Research & Media"
  description="Contact Emon Hossain for relevant AI-systems projects, creator collaborations, speaking, research or media inquiries."
  ogTitle="Contact Emon Hossain"
>
  <div class="container section" style="max-width:46rem;">
    <div class="section-title">
      <div class="eyebrow">CONTACT</div>
      <h2>Start with context.</h2>
      <p>Tell me what you are working on, what outcome you need and why you think I am a relevant fit. I will route the inquiry to the appropriate personal, commercial or research context.</p>
    </div>

    <div class="contact-grid">
      <a href="mailto:contact@emonhossain.pro?subject=Business%20or%20AI%20Systems%20Inquiry" class="contact-card">
        <div class="label">Business / AI Systems</div>
        <div class="value">contact@emonhossain.pro</div>
        <div class="hint">Projects, advisory and workflow discussions</div>
      </a>
      <a href="mailto:contact@emonhossain.pro?subject=Creator%2C%20Speaking%2C%20Research%20or%20Media%20Inquiry" class="contact-card">
        <div class="label">Creator / Speaking / Research / Media</div>
        <div class="value">contact@emonhossain.pro</div>
        <div class="hint">Collaborations, interviews, talks and research-related contact</div>
      </a>
    </div>

    <div style="margin:3rem auto 0;padding:1.5rem;background:white;border:1px solid var(--brand-stone-200);border-radius:1rem;">
      <div class="eyebrow">WHAT TO INCLUDE</div>
      <p style="color:var(--brand-stone-600);font-size:.875rem;line-height:1.75;margin-top:.75rem;">A useful first message includes your organization or project, the problem or topic, the intended outcome, any important deadline, and the best way to continue the conversation.</p>
    </div>
  </div>
</BaseLayout>
