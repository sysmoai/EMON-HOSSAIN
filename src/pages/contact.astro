---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Emon Hossain — AI Systems & Automation"
  description="Contact Emon Hossain for AI systems, automation, research, media, or business enquiries. Dhaka, Bangladesh."
  ogTitle="Contact Emon Hossain"
>
  <div class="container section" style="max-width: 40rem;">
    <div class="section-title">
      <div class="eyebrow">CONTACT</div>
      <h2>Let's talk.</h2>
      <p>For business implementation, send the current workflow, bottleneck, and desired outcome. Relevant work is routed through SYSmoAI.</p>
    </div>

    <div class="contact-grid">
      <a href="mailto:contact@emonhossain.pro" class="contact-card">
        <div class="label" style="color: var(--brand-indigo);">Email</div>
        <div class="value">contact@emonhossain.pro</div>
        <div class="hint">Business, media, and partnership enquiries</div>
      </a>
      <a href="https://wa.me/8801711638693" class="contact-card">
        <div class="label" style="color: var(--brand-emerald);">WhatsApp</div>
        <div class="value">+880 1711-638693</div>
        <div class="hint">SYSmoAI + emonhossain.pro enquiries</div>
      </a>
      <a href="https://sysmoai.com" class="contact-card">
        <div class="label" style="color: var(--brand-ink);">SYSmoAI</div>
        <div class="value">AI systems &amp; automation</div>
        <div class="hint">Implementation and ongoing operations</div>
      </a>
    </div>

    <div style="text-align: center; margin-top: 3rem; color: var(--brand-stone-400); font-size: 0.75rem;">
      Dhaka, Bangladesh
    </div>
  </div>
</BaseLayout>
