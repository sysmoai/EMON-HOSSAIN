---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Newsletter | Emon Hossain — Systems, AI & No-Code Notes"
  description="Practical notes on AI, no-code automation, and systems thinking for Bangladeshi founders and operators."
  ogTitle="Newsletter — Emon Hossain"
>
  <div class="container section" style="max-width: 40rem;">
    <div class="section-title">
      <div class="eyebrow">NEWSLETTER</div>
      <h2>Systems, AI & No-Code Notes.</h2>
      <p>Practical notes on AI, no-code automation, and systems thinking for Bangladeshi founders and operators. No fluff, no weekly pressure — only when there's something worth saying.</p>
    </div>
    <div style="background: white; border: 1px solid var(--brand-stone-200); border-radius: 1rem; padding: 1.5rem; text-align: center;">
      <p style="color: var(--brand-stone-500); font-size: 0.875rem;">The newsletter is launching soon. Subscribe to get notified.</p>
      <div style="margin-top: 1.5rem;">
        <a href="mailto:contact@emonhossain.pro?subject=Subscribe" class="btn-primary">Subscribe via Email</a>
      </div>
    </div>
  </div>
</BaseLayout>