---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI From Hype to Useful Work | Draft Topic | Emon Hossain"
  description="A draft topic from Emon Hossain on evaluating whether AI improves a real workflow or simply adds novelty and complexity."
>
  <div class="container" style="padding:4rem 1.5rem;max-width:42rem;">
    <div class="eyebrow">DRAFT TOPIC · APPLIED AI</div>
    <h1 style="font-size:1.75rem;font-weight:800;color:var(--brand-ink);margin-top:1rem;">AI From Hype to Useful Work</h1>
    <p style="color:var(--brand-stone-600);font-size:.95rem;margin-top:1rem;line-height:1.75;">The planned article will examine a simple question: does adding AI reduce friction, improve a decision or make a workflow easier to operate — or does it only make the demo look more advanced?</p>
    <div style="margin-top:2rem;padding:1.25rem;background:white;border:1px solid var(--brand-stone-200);border-radius:1rem;">
      <p style="color:var(--brand-stone-500);font-size:.85rem;line-height:1.7;">This is a transparent pre-publication topic page. It is not presented as a completed case study and does not make performance claims before the supporting work is published.</p>
    </div>
  </div>
</BaseLayout>
