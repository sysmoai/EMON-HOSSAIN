---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Creator & Video Work | Emon Hossain — Bangladesh"
  description="Emon Hossain is a Bangladesh-based AI creator and systems practitioner building practical AI-video workflows, bilingual creator education, and business-focused visual experiments."
  ogTitle="AI Creator & Video Work — Emon Hossain"
>
  <section class="hero">
    <div class="container" style="max-width: 52rem;">
      <div class="eyebrow">AI CREATOR · BANGLA + ENGLISH · BANGLADESH</div>
      <h1>Practical AI video.<br /><span class="gradient-text">Built from Bangladesh.</span></h1>
      <p>
        I am Emon Hossain, a Bangladesh-based AI systems practitioner and creator. I am building
        useful Bangla and English content around AI video, creator workflows, visual storytelling,
        and real business use cases — with an emphasis on showing the process, not just the final output.
      </p>
      <div class="hero-cta">
        <a href="#work" class="btn-primary">View creator work</a>
        <a href="mailto:contact@emonhossain.pro" class="btn-outline">Creator &amp; partnership inquiries</a>
      </div>
    </div>
  </section>

  <section class="section" style="background: white; border-top: 1px solid var(--brand-stone-200); border-bottom: 1px solid var(--brand-stone-200);">
    <div class="container">
      <div class="section-title">
        <div class="eyebrow">CREATOR FOCUS</div>
        <h2>What I am building</h2>
        <p>Content designed to be useful to creators and businesses, not generic AI demonstrations.</p>
      </div>
      <div class="grid-4">
        <article class="service-card">
          <div class="phase">01</div>
          <h3>Bilingual AI education</h3>
          <p class="desc">Bangla and English tutorials that make modern video and AI workflows easier to understand and reproduce.</p>
        </article>
        <article class="service-card">
          <div class="phase">02</div>
          <h3>Creator workflows</h3>
          <p class="desc">Before-and-after breakdowns covering editing, captions, AI assets, repurposing, and short-form production.</p>
        </article>
        <article class="service-card">
          <div class="phase">03</div>
          <h3>Bangladesh stories</h3>
          <p class="desc">Visual experiments grounded in Bangladesh rather than interchangeable AI aesthetics, with local context and global-quality execution.</p>
        </article>
        <article class="service-card">
          <div class="phase">04</div>
          <h3>Commercial concepts</h3>
          <p class="desc">Practical social-video and advertising concepts for founders, creators, SMEs, products, and services.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container" style="max-width: 56rem;">
      <div class="section-title">
        <div class="eyebrow">SELECTED WORK</div>
        <h2>Evidence first.</h2>
        <p>Only published, attributable creator work will be listed here. New AI-video case studies are currently being prepared.</p>
      </div>
      <div class="grid-3">
        <article class="service-card">
          <div class="phase">CASE STUDY 01</div>
          <h3>AI creator education</h3>
          <p class="desc">A short-form, bilingual walkthrough demonstrating a practical AI-video workflow from idea to publishable output.</p>
          <p style="margin-top: 1rem; color: var(--brand-stone-500); font-size: 0.75rem;">Public link will be added after publication.</p>
        </article>
        <article class="service-card">
          <div class="phase">CASE STUDY 02</div>
          <h3>Real-footage transformation</h3>
          <p class="desc">A raw-to-polished social-video edit using genuine creator footage, captions, pacing, audio cleanup, and branded delivery.</p>
          <p style="margin-top: 1rem; color: var(--brand-stone-500); font-size: 0.75rem;">Public link will be added after publication.</p>
        </article>
        <article class="service-card">
          <div class="phase">CASE STUDY 03</div>
          <h3>AI commercial concept</h3>
          <p class="desc">A concise commercial-style visual concept showing how generative footage and editing can support real marketing use cases.</p>
          <p style="margin-top: 1rem; color: var(--brand-stone-500); font-size: 0.75rem;">Public link will be added after publication.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--brand-ink); color: white;">
    <div class="container" style="max-width: 48rem; text-align: center;">
      <div class="eyebrow" style="color: var(--brand-stone-400);">COLLABORATION</div>
      <h2 style="font-size: 1.875rem; margin-top: 0.75rem;">Open to useful creator partnerships.</h2>
      <p style="color: var(--brand-stone-400); margin: 1rem auto 0; max-width: 38rem;">
        I am interested in AI-video creator programs, product education, feature demonstrations,
        launch content, practical case studies, and collaborations that are relevant to creators and businesses in Bangladesh and beyond.
      </p>
      <div style="margin-top: 1.5rem;">
        <a href="mailto:contact@emonhossain.pro" class="btn-primary" style="background: white; color: var(--brand-ink);">contact@emonhossain.pro</a>
      </div>
    </div>
  </section>
</BaseLayout>
